  "triggers": [
    {
      "id": "p5_count_init",
      "name": "P5カウンター初期化",
      "enabled": true,
      "type": "cast_start",
      "match": {
        "cast_id": "0xPHASE5_START"
      },
      "actions": [],
      "set_variable": {
        "name": "p5_safe_count",
        "operation": "reset"
      },
      "metadata": {
        "notes": "P5突入時に状態変数をリセット"
      }
    },
    {
      "id": "p5_safe_zone_counter",
      "name": "P5安置ギミック発生カウント",
      "enabled": true,
      "type": "cast_start",
      "match": {
        "cast_id": "0xP5_NARROW_SAFE"
      },
      "actions": [],
      "set_variable": {
        "name": "p5_safe_count",
        "operation": "increment"
      }
    },
    {
      "id": "p5_safe_first",
      "name": "P5激狭安置（1回目）",
      "enabled": false,
      "type": "cast_start",
      "match": {
        "cast_id": "0xP5_NARROW_SAFE"
      },
      "conditions": {
        "all_of": [
          { "variable": "p5_safe_count", "equals": 1 }
        ]
      },
      "actions": [
        {
          "type": "direction_call",
          "safe_zone": {
            "method": "telegraph_gap",
            "params": {
              "search_origin": "arena_center",
              "search_radius": 18,
              "telegraphs": [
                { "shape": "fan", "origin": "boss", "facing_deg": 0, "angle_width_deg": 160, "radius": 25 },
                { "shape": "fan", "origin": "boss", "facing_deg": 180, "angle_width_deg": 160, "radius": 25 }
              ]
            },
            "output_format": {
              "tts_template": "安置 ${direction_clock}時方向",
              "direction_style": "clock"
            }
          },
          "tts": true,
          "overlay": true
        },
        {
          "type": "field_marker",
          "position": {
            "method": "telegraph_gap",
            "params": {
              "search_origin": "arena_center",
              "search_radius": 18,
              "telegraphs": [
                { "shape": "fan", "origin": "boss", "facing_deg": 0, "angle_width_deg": 160, "radius": 25 },
                { "shape": "fan", "origin": "boss", "facing_deg": 180, "angle_width_deg": 160, "radius": 25 }
              ]
            }
          },
          "shape": "circle",
          "radius": 1.5,
          "color": "#00FF00",
          "duration": 5
        },
        {
          "type": "proximity_feedback",
          "safe_zone": {
            "method": "telegraph_gap",
            "params": {
              "search_origin": "arena_center",
              "search_radius": 18,
              "telegraphs": [
                { "shape": "fan", "origin": "boss", "facing_deg": 0, "angle_width_deg": 160, "radius": 25 },
                { "shape": "fan", "origin": "boss", "facing_deg": 180, "angle_width_deg": 160, "radius": 25 }
              ]
            }
          },
          "tolerance": 1.0,
          "in_sound": "sounds/safe_in.wav",
          "out_sound": "sounds/safe_out.wav",
          "show_distance": true
        },
        {
          "type": "timer_bar",
          "label": "安置発動まで",
          "duration": 5,
          "color": "#FF0000",
          "warn_at": 2
        }
      ],
      "metadata": {
        "notes": "参考例（enabled:false）：telegraph_gapプリセットで複数AoEの隙間を計算し激狭安置に対応。telegraphsは扇2枚の例。録画後に実 cast_id と実テレグラフ形状（origin/facing_deg/angle_width_deg）へ差し替えて有効化する。facing_degは rotation=0=南/CCW正の規約"
      }
    },
    {
      "id": "p5_safe_subsequent",
      "name": "P5激狭安置（2回目以降）",
      "enabled": false,
      "type": "cast_start",
