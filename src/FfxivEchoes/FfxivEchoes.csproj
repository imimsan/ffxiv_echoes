<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.1.0</Version>
    <Authors>imimsan</Authors>
    <Company>imimsan</Company>
    <Description>FFXIV 絶コンテンツ攻略支援プラグイン (Dalamud)</Description>
    <PackageProjectUrl>https://github.com/imimsan/ffxiv_echoes</PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- M7: TTS via SAPI5（Windows 専用） -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <!-- M7: WAV 再生用 SoundPlayer（System.Media.SoundPlayer は Windows 専用） -->
    <PackageReference Include="System.Windows.Extensions" Version="9.0.0" />
    <!-- M9: 音量制御つき音声出力 + デバイス列挙（NAudio meta = Core/Wasapi/WinMM/Asio/MIDI を含む） -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
